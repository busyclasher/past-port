# Required by the token endpoint. Never expose these values in browser code.
ELEVENLABS_API_KEY=replace_with_your_server_side_key
SESSION_SECRET=replace_with_at_least_32_random_characters

# Exact public origin allowed to request tokens in production.
# For local development, http://localhost:4173 is used by default.
APP_ORIGIN=http://localhost:4173
PORT=4173
